{
  "trash_id": "homeserver-english-anime-audio",
  "name": "English Anime Audio",
  "includeCustomFormatWhenRenaming": true,
  "specifications": [
    {
      "name": "Explicit English audio or verified English dub group",
      "implementation": "ReleaseTitleSpecification",
      "negate": false,
      "required": true,
      "fields": {
        "value": "(?i)\\b(?:english|eng)[ ._-]*(?:dub(?:bed)?|audio)\\b|\\b(?:dub(?:bed)?|audio)[ ._-]*(?:english|eng)\\b|\\bFuni[ ._-]*Dub\\b|\\[(?:JA|JPN|Japanese)[ ._-]*\\+[ ._-]*(?:EN|ENG|English)\\]|\\[(?:EN|ENG|English)[ ._-]*\\+[ ._-]*(?:JA|JPN|Japanese)\\]|\\[Golumpa\\]|-Golumpa\\b|\\bEnglish[ ._-]+Anime[ ._-]+Audio\\b"
      }
    },
    {
      "name": "No contradictory audio or sub-only labels",
      "implementation": "ReleaseTitleSpecification",
      "negate": true,
      "required": true,
      "fields": {
        "value": "(?i)\\b(?:no|non|not|without)[ ._-]*(?:(?:english|eng)[ ._-]*(?:dub(?:bed)?|audio)|(?:dub(?:bed)?|audio)[ ._-]*(?:english|eng))\\b|\\b(?:japanese|jpn|ja|french|fre|fra|german|ger|deu|spanish|spa|italian|ita|russian|rus|portuguese|por|korean|kor|chinese|chi|zho)[ ._-]*(?:dub(?:bed)?|audio)[ ._-]*only\\b|\\b(?:french|fre|fra|german|ger|deu|spanish|spa|italian|ita|russian|rus|portuguese|por)[ ._-]*dub(?:bed)?\\b|\\bsub(?:s|bed)?[ ._-]*only\\b|\\[(?:JA|JPN|Japanese)\\]|\\b(?:english|eng)[ ._-]+(?:audio[ ._-]+)?commentary\\b"
      }
    }
  ]
}
